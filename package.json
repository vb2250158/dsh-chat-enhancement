{
  "name": "dsh-chat-enhancement",
  "version": "0.3.46",
  "description": "Inline previews for DSH chat tool results",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    "./image-attachments": "./src/image-attachments.js",
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-goal"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-attachment-local": ">=0.1.5-rc.2",
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.8 || >=0.1.0-alpha.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.8 || >=0.1.0-alpha.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.8 || >=0.1.0-alpha.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.8 || >=0.1.0-alpha.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.8 || >=0.1.0-alpha.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.8 || >=0.1.0-alpha.0",
    "react": "^18.2.0"
  },
  "files": [
    "scripts/recover-sessions.mjs",
    "src/question-content.js",
    "src/session-recovery.js",
    "src/session-recovery-client.js",
    "src/background-jobs.js",
    "src/image-attachments.js",
    "src/image-type.js",
    "lib/index.js",
    "lib/client.js",
    "lib/typert.host.js",
    "src/index.js",
    "src/client.js",
    "src/annotations.js",
    "src/languages.js",
    "src/typert.host.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "patches/",
    "host-patches",
    "src/goal-metrics.js"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vb2250158/dsh-chat-enhancement.git"
  },
  "license": "MIT"
}
