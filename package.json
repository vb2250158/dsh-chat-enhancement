{
  "name": "dsh-chat-enhancement",
  "version": "0.3.60",
  "description": "Inline previews for DSH chat tool results",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    "./image-attachments": "./src/image-attachments.js",
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./image-attachments/locale/*.json": "./locale/image-attachments/*.json",
    "./image-attachments/icon": "./image-attachments.svg"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-goal",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-attachment-local": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/cordis": ">=4.0.5-alpha.1 <5.0.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-alpha.1 <0.3.0",
    "react": "^18.2.0",
    "@deepseek-ai/schemastery": ">=3.18.5-alpha.1 <4.0.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.2.1-alpha.1 <0.3.0"
  },
  "files": [
    "scripts/recover-sessions.mjs",
    "src/question-content.js",
    "src/session-recovery.js",
    "src/session-recovery-client.js",
    "src/background-jobs.js",
    "src/image-attachments.js",
    "src/image-type.js",
    "lib/index.js",
    "lib/client.js",
    "lib/typert.host.js",
    "src/index.js",
    "src/client.js",
    "src/annotations.js",
    "src/languages.js",
    "src/typert.host.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "patches/",
    "host-patches",
    "src/goal-metrics.js",
    "src/code-references.js",
    "src/code-references-client.js",
    "docs",
    "locale",
    "icon.svg",
    "ICON_LICENSE.txt",
    "image-attachments.svg"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vb2250158/dsh-chat-enhancement.git"
  },
  "license": "MIT",
  "icon": "./icon.svg"
}
