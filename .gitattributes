# Patch files must reach every checkout byte-identical to the diff they were
# cut from: a working copy that rewrites their line endings makes `git apply`
# fail on the very machines this file is meant to serve.
patches/*.patch -text
patches/2026-10-08-workspace-sticky-headers.patch whitespace=-blank-at-eol
patches/2026-10-09-session-list-loading.patch whitespace=-blank-at-eol,-blank-at-eof
host-patches/*.patch -text
# 标准补丁的上下文行需要保留首个空格。
host-patches/*.patch whitespace=-blank-at-eol
patches/2026-10-10-compaction-statistics.patch whitespace=-blank-at-eol
