+/** 从已提交事件维护免消息续作资格，避免每次启动扫描完整历史。 */
+import { z } from 'zod'
+import { SessionSeq } from '@deepseek-ai/dsh-session'
+import type { ProjectionDefinition } from '@deepseek-ai/dsh-session-projection'
+
+const schema = z.object({
+  startSeq: z.number().int().nonnegative().transform(SessionSeq).nullable(),
+  kind: z.enum(['none', 'open', 'interrupted', 'quota', 'closed']),
+})
+
+declare module '@deepseek-ai/dsh-session-projection/types' {
+  interface SessionProjectionStateMap {
+    /** 最后轮次的原生续作资格；后续用户消息使已结束轮次失效。 */
+    nativeContinuation: z.infer<typeof schema>
+  }
+}
+
+/** 只保留续作必需的轮次坐标和最终结束分类。 */
+export const nativeContinuationProjection = {
+  key: 'nativeContinuation',
+  stateVersion: 1,
+  stateSchema: schema,
+  init: () => ({ startSeq: null, kind: 'none' }),
+  apply: (state, event) => {
+    switch (event.type) {
+      case 'turn/start':
+        return { startSeq: event.seq, kind: 'open' }
+      case 'turn/end': {
+        const { reason } = event.data
+        if (reason.kind === 'interrupted') return { ...state, kind: 'interrupted' }
+        if (reason.kind === 'error') {
+          const { error } = reason
+          if (error.code === 'QUOTA' || (error.code === 'PI_AI_ERROR' && /^402 status code(?:\s|$)/u.test(error.message))) return { ...state, kind: 'quota' }
+        }
+        return { ...state, kind: 'closed' }
+      }
+      case 'user/message':
+        return state.kind === 'open' ? state : { ...state, kind: 'closed' }
+      default:
+        // 其它扩展事件不改变轮次的结束原因和续作资格。
+        return state
+    }
+  },
+} satisfies ProjectionDefinition<'nativeContinuation', z.infer<typeof schema>>
